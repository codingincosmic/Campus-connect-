# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# Your hosted Postgres connection string.
#
# Neon      : dashboard -> Connection Details. IMPORTANT: use the connection
#             string WITHOUT "-pooler" in the host for migrations to work.
#             e.g. postgresql://user:pass@ep-cool-name-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Supabase  : Project Settings -> Database -> Connection string -> URI
#             e.g. postgresql://postgres:pass@db.xxxx.supabase.co:5432/postgres
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# --- Server -----------------------------------------------------------------
PORT=4000
NODE_ENV=development

# --- Auth -------------------------------------------------------------------
# Secret used to sign JWTs. Generate a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"
# How long a login session lasts.
JWT_EXPIRES_IN="7d"

# --- CORS -------------------------------------------------------------------
# Where the frontend runs. Used for CORS when the client is served from a
# different origin. In local dev the Vite proxy makes this same-origin anyway.
CLIENT_ORIGIN="http://localhost:5173"

# --- File storage -----------------------------------------------------------
# "local" writes to server/uploads. Swap to "s3" later without touching
# feature code (see src/lib/storage.js).
STORAGE_DRIVER="local"
UPLOAD_DIR="uploads"
# Max upload size in megabytes.
MAX_UPLOAD_MB=10

# --- Academic defaults ------------------------------------------------------
# Attendance below this percentage marks a student as a defaulter.
ATTENDANCE_THRESHOLD=75
# How many days back a teacher may edit attendance.
ATTENDANCE_EDIT_WINDOW_DAYS=7
# The college's IANA timezone. Used to decide what "today" is when marking
# attendance. Get this wrong on a UTC server and early-morning marking is
# rejected as being "in the future".
COLLEGE_TIMEZONE=Asia/Kolkata

# --- Seed data --------------------------------------------------------------
# Password given to every demo account created by `npm run db:seed`.
SEED_PASSWORD="Password@123"
